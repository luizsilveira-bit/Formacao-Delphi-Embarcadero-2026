<TfrxReport Version="2026.2.3" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="692223" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="46242,408066956" ReportOptions.Description.Text="" ReportOptions.LastChange="46242,5676229282" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TotalPokemonsImpressos: Integer;&#13;&#10;&#13;&#10;function ClassificarNivel(ANivel: Integer): String;&#13;&#10;begin&#13;&#10;  if ANivel &#62;= 40 then&#13;&#10;    Result := &#39;Nível de Elite&#39;&#13;&#10;  else if ANivel &#62;= 30 then&#13;&#10;    Result := &#39;Nível Avançado&#39;&#13;&#10;  else if ANivel &#62;= 20 then&#13;&#10;    Result := &#39;Nível Intermediário&#39;&#13;&#10;  else&#13;&#10;    Result := &#39;Nível Inicial&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailDataPokemonsOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(TotalPokemonsImpressos);    &#13;&#10;  MemoClassificacaoNivel.Text := ClassificarNivel(&#60;Pokemons.&#34;NIVEL&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportOnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; TotalPokemonsImpressos := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MemoTotalPokemonsImpressos.Text := &#39;Total de Pokémons impressos: &#39; + IntToStr(TotalPokemonsImpressos);&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" OnStartReport="ReportOnStartReport">
